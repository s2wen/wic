generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StudyGroup {
  id          String    @id @default(cuid())
  name        String
  subject     String
  description String?
  location    String?
  time        String?
  date        DateTime?
  spots       Int       @default(5)
  color       String    @default("teal")
  createdAt   DateTime  @default(now())
  members        User[]    @relation("StudyGroupMembers")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String?
  pronouns        String?
  image           String?
  googleId        String?      @unique
  university      String?
  major           String?
  year            String?
  classes         String[]
  profileComplete Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  StudyGroup      StudyGroup[] @relation("StudyGroupMembers")
}
